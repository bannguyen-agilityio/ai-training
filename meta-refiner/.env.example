# Any OpenAI-compatible endpoint (OpenAI, 9router, ...).
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=your-key
# The META model writes and refines prompts. Use your strongest model.
META_MODEL=your-strong-model
# The TARGET model answers using the refined prompt. Can be smaller/cheaper.
TARGET_MODEL=your-cheap-model
