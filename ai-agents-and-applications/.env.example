# Copy to .env and fill in. Never commit .env.

# API key for your LLM provider / gateway
OPENAI_API_KEY=sk-your-key-here

# Custom base URL for an OpenAI-compatible endpoint
# (LiteLLM proxy, vLLM, Ollama, Azure gateway, etc.)
# Examples:
#   http://localhost:4000/v1     LiteLLM proxy
#   http://localhost:11434/v1    Ollama
#   https://api.openai.com/v1    OpenAI default
# 9Router
OPENAI_BASE_URL=http://localhost:20128/v1

# Model name as exposed by that endpoint
OPENAI_MODEL=oc/deepseek-v4.1-flash-free
